      "tag": "字节副本",
      "row": 2,
      "col": 0
    },
    {
      "id": "norm",
      "type": "backend",
      "label": "归一化器",
      "sublabel": "records / turns / steps",
      "row": 2,
      "col": 4
    },
    {
      "id": "store",
      "type": "database",
      "label": "SQLite 派生库",
      "sublabel": "sessions · records · FTS",
      "tag": "可重建",
      "row": 3,
      "col": 2
    },
    {
      "id": "api",
      "type": "backend",
      "label": "HTTP 服务",
      "sublabel": "trajview :5178",
      "row": 4,
      "col": 2
    },
    {
      "id": "web",
      "type": "frontend",
      "label": "浏览器界面",
      "sublabel": "账本 · 时间线 · 详情",
      "row": 5,
      "col": 2
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "来源侧（全程只读）",
      "wraps": [
        "codex",
        "claude",
        "dsh"
      ]
    },
    {
      "kind": "region",
      "label": "trajview 派生层（可整体删除后从 vault 重建）",
      "wraps": [
        "adapters",
        "vault",
        "norm",
        "store",
        "api",
        "web"
      ]
    }
  ],
  "connections": [
    {
      "id": "codex-in",
      "from": "codex",
      "to": "adapters",
      "label": "发现会话",
      "variant": "default"
    },
    {
      "id": "claude-in",
      "from": "claude",
      "to": "adapters",
      "label": "发现会话",
      "labelDy": 24
    },
    {
      "id": "dsh-in",
      "from": "dsh",
      "to": "adapters",
      "label": "发现会话"
    },
    {
      "id": "capture",
      "from": "adapters",
      "to": "vault",
      "label": "摄入时字节归档",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "top"
    },
    {
      "id": "replay",
      "from": "vault",
      "to": "adapters",
      "label": "--from-vault 重放",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "normalize",
      "from": "adapters",
      "to": "norm",
      "label": "逐源解析",
      "variant": "emphasis"
    },
    {
      "id": "persist",
      "from": "norm",
      "to": "store",
      "label": "整会话事务写入"
    },
    {
      "id": "serve",
      "from": "store",
      "to": "api",
      "label": "分页 / 计数 / FTS",
      "labelDy": 24
    },
    {
      "id": "render",
      "from": "api",
      "to": "web",
      "label": "REST",
      "variant": "emphasis",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "来源",
      "items": [
        "三家 CLI 的本地日志，适配器全程只读",
        "vault 之外的任何环节都不写回来源"
      ]
    },
    {
      "dot": "emerald",
      "title": "派生",
      "items": [
        "逐源归一化后写入单库，可整库删除重建",
        "记录级 flag 保留保真信息，如参数缺失、钩子注入"
      ]
    },
    {
      "dot": "rose",
      "title": "归档",
      "items": [
        "vault 保存原始字节与来源路径",
        "来源被轮转删除后，重建只依赖它"
      ]
    }
  ]
}