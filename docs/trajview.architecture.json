{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "trajview 轨迹观察台",
    "subtitle": "三源只读摄入 · 归档重放 · 归一化落库 · 账本/时间线/详情",
    "output": "trajview-architecture.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-path",
        "label": "主链路",
        "focus": [
          "codex",
          "claude",
          "dsh",
          "adapters",
          "norm",
          "store",
          "api",
          "web"
        ],
        "note": "从三家 CLI 的本地日志到浏览器的一条直线。"
      },
      {
        "id": "vault-replay",
        "label": "归档与重放",
        "focus": [
          "adapters",
          "vault",
          "norm"
        ],
        "note": "来源日志会被轮转删除，vault 是可重建派生层的唯一依据。"
      },
      {
        "id": "derived-only",
        "label": "派生层",
        "focus": [
          "adapters",
          "norm",
          "store",
          "api",
          "web"
        ],
        "note": "除 vault 外的一切都可随时删库重建。"
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "cols": 6,
    "cellW": 168,
    "cellH": 108,
    "gapX": 26,
    "gapY": 22
  },
  "components": [
    {
      "id": "codex",
      "type": "external",
      "label": "Codex rollouts",
      "sublabel": "~/.codex/sessions",
      "row": 0,
      "col": 0
    },
    {
      "id": "claude",
      "type": "external",
      "label": "Claude Code JSONL",
      "sublabel": "~/.claude/projects/<slug>",
      "row": 0,
      "col": 2
    },
    {
      "id": "dsh",
      "type": "external",
      "label": "DSH session log",
      "sublabel": "~/.dsh",
      "row": 0,
      "col": 4
    },
    {
      "id": "adapters",
      "type": "backend",
      "label": "源适配器",
      "sublabel": "SessionRef + 行读取",
      "tag": "只读",
      "row": 1,
      "col": 2
    },
    {
      "id": "vault",
      "type": "database",
      "label": "Vault 归档",
