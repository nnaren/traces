{
  "name": "trajview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH-style unified trajectory observer for DSH / Codex / Claude Code",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "ingest": "tsx src/cli/ingest.ts",
    "start": "tsx src/server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "audit:vault": "tsx scripts/audit-vault-dupes.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
